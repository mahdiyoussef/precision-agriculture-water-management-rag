# Environment Configuration
# Copy this to .env and fill in your values

# LLM Configuration
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda

# Vector Store
VECTOR_STORE_COLLECTION=water_management_docs
VECTOR_STORE_PERSIST=./data/vector_store

# Performance
ENABLE_CACHING=true
CACHE_TTL=3600
GPU_MEMORY_FRACTION=0.8

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_system.log

# Weather Configuration (for agricultural context enrichment)
# API Provider: "open-meteo" (free, no key) or "openweathermap" (requires key)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=  # Only required for OpenWeatherMap
WEATHER_CACHE_TTL=1800
